# Composer
/vendor/
/composer.phar
composer.lock

# Yii runtime & generated assets
/runtime/

# Yii AssetManager publish folder.
# Keep the folder in the repo (so it exists after cloning) but ignore
# the generated/published files inside it.
/web/assets/*
!/web/assets/.gitkeep

# Local configuration
/config/db.php
/config/params-local.php
/config/web-local.php
.env
*.local.php

# Uploads: include all content and images (logos, fotos, fondos e icono)
# The whole folder is tracked; nothing inside is ignored.

# IDE / OS
/.idea/
/.vscode/
*.log
.DS_Store
Thumbs.db

# Cache
/yii.bat
*.cache